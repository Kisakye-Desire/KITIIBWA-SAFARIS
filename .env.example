# ============================================================================
# KITIIBWA SAFARIS - Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# ============================================================================

# DATABASE CONFIGURATION
# Get your PostgreSQL URL from Neon (https://neon.tech)
DATABASE_URL=postgresql://user:password@host/database

# BUSINESS INFORMATION
# Update with your actual business details
BUSINESS_EMAIL=contact@kitiibwasafaris.com
BUSINESS_PHONE=+256 (0) 708 898 424
BUSINESS_WHATSAPP=+256 708 898 424

# EMAIL CONFIGURATION
# Choose your email provider: 'resend', 'nodemailer', or 'sendgrid'
EMAIL_PROVIDER=resend
ADMIN_EMAIL=admin@kitiibwasafaris.com
CONTACT_FORM_EMAIL=contact@kitiibwasafaris.com
BOOKINGS_EMAIL=bookings@kitiibwasafaris.com
DONATIONS_EMAIL=donations@kitiibwasafaris.com
EVENTS_EMAIL=events@kitiibwasafaris.com

# RESEND EMAIL SERVICE (https://resend.com)
# Only required if EMAIL_PROVIDER=resend
RESEND_API_KEY=

# NODEMAILER EMAIL SERVICE (Gmail example)
# Only required if EMAIL_PROVIDER=nodemailer
EMAIL_USER=
EMAIL_PASSWORD=

# SENDGRID EMAIL SERVICE (https://sendgrid.com)
# Only required if EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@kitiibwasafaris.com

# STRIPE PAYMENT CONFIGURATION (https://stripe.com)
# Get keys from your Stripe Dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# GOOGLE ANALYTICS (Optional)
# Leave empty to disable
NEXT_PUBLIC_GA_ENABLED=false
NEXT_PUBLIC_GA_ID=

# BASE URL FOR DEPLOYMENT
# Update this when deploying to production
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ENVIRONMENT
NODE_ENV=development
VERCEL_ENV=development

# FEATURE FLAGS
ENABLE_BOOKINGS=true
ENABLE_DONATIONS=true
ENABLE_EVENTS=true
ENABLE_NEWSLETTER=true
ENABLE_GALLERY=true
ENABLE_BLOG=false

# SECURITY
RATE_LIMITING_ENABLED=true
LOG_IP_ADDRESSES=true
ALLOWED_ORIGINS=http://localhost:3000

# BETTER AUTH (Session Management)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.local
# 2. Update all PLACEHOLDER values with your actual information
# 3. Restart your development server: npm run dev
# 4. Never commit .env.local to version control
# ============================================================================
